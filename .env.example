# 로컬 개발 전용. .env로 복사해 값을 채운다. 운영 값/Secret을 넣지 않는다.
# 계정(CP-DB-001 → PAYMENT-DBACCOUNT-001): MASTER·PAYMENT마다 runtime 계정(앱 DataSource. DB 단위 권한 없이 runtime role의 표 단위 권한만 —
# append-only 표는 SELECT·INSERT만)과 migration 계정(자기 DB ALL, GRANT OPTION 없음, Flyway 전용)을 둔다. 표 단위 권한은 각 앱의 권한 migration이
# 초기화 스크립트의 procedure로 준다. FINANCIAL도 같은 구조다(FIN-DBACCOUNT-001 — 아래 financial-batch 절의 기존 volume 절차).
# 계정·role·procedure는 docker/mysql/init/01-owned-databases.sh가 **빈 volume의 첫 기동에만** 만든다.
# 이 변경(PAYMENT-DBACCOUNT-001) 전에 만든 compose volume은 runtime 계정이 아직 DB 단위 권한을 갖고 있고(MASTER-BOOT-001 이후 volume은
# SELECT/INSERT/UPDATE/DELETE, 그 이전 volume은 단일 계정에 ALL — DDL 포함이라 append-only 표를 DROP할 수도 있다) role·procedure가 없어서
# payment-api의 권한 migration(V2)이 실패한다. 둘 중 하나를 한다:
#   (a) volume 재생성(로컬 데이터가 지워진다): docker compose down -v && docker compose up -d
#   (b) 데이터 유지: 실행 중인 컨테이너에서 스크립트를 한 번 직접 실행한다(재실행 안전 — runtime 계정의 DB 단위 ALL·GRANT OPTION과
#       migration 계정의 DB 단위 GRANT OPTION REVOKE, grantor 잠금 재적용, role·grantor·procedure 생성. 표 단위 권한은 유지).
#       docker compose exec mysql bash /docker-entrypoint-initdb.d/01-owned-databases.sh
#       그다음 payment-api를 기동하면 Flyway(migration 계정)가 V2로 표 단위 권한을 준다. 수동 GRANT/REVOKE로 맞출 때는 위 스크립트의 SQL과
#       같은 결과여야 한다(apps/payment-api DatabaseAccountSeparationSpec의 SHOW GRANTS 기대값 참고).
# WEBHOOK-001(D-WH-009): 초기화 스크립트가 PAYMENT에 열 단위 UPDATE helper(paycore_payment_privilege.grant_runtime_column_update)를 추가했다. 그 전에 만든 volume은
#   위 (b)처럼 스크립트를 한 번 다시 실행해야 payment-api 권한 migration V24가 적용된다(재실행 안전 — 이미 준 표·열 권한 유지). 실행하지 않으면 V24가 실패해 기동하지 않는다(fail-closed).
# 참고: MASTER에는 아직 업무 테이블이 없어 runtime 계정이 받은 표 권한이 없으므로 master-api는 MASTER DB에 접속할 수 없다(1044).
#       첫 MASTER 테이블과 그 권한 migration은 MASTER-DOMAIN-001에서 추가된다.
PAYCORE_MYSQL_ROOT_PASSWORD=
PAYCORE_MASTER_DB_PASSWORD=
PAYCORE_MASTER_DB_MIGRATION_PASSWORD=
PAYCORE_PAYMENT_DB_PASSWORD=
PAYCORE_PAYMENT_DB_MIGRATION_PASSWORD=
PAYCORE_FINANCIAL_DB_PASSWORD=
PAYCORE_FINANCIAL_DB_MIGRATION_PASSWORD=

# master-api 로컬 실행용 (비밀번호는 위 PAYCORE_MASTER_DB_PASSWORD / PAYCORE_MASTER_DB_MIGRATION_PASSWORD 공유)
PAYCORE_MASTER_DB_URL=jdbc:mysql://127.0.0.1:3306/paycore_master
PAYCORE_MASTER_DB_USERNAME=paycore_master
PAYCORE_MASTER_DB_MIGRATION_USERNAME=paycore_master_migration

# DEMO-SEED-001 §12(부록 D) — 권리 채널(MASTER → PAYMENT Snapshot) Demo 설정. **Demo 값 — 운영값 아님.** 키 한 쌍은 로컬에서 새로 만든다
# (`openssl rand -base64 32`, ADMIN 채널 키와 다른 값 — 저장소에 값을 두지 않는다). master-api dispatch 키 = payment-api inbox signing-keys[0].
# master-api 프로세스에만 SPRING_APPLICATION_JSON으로 넘긴다(웹 프로세스와 `demo-seed` 명령 프로세스가 같은 값 — 설정 검증이 명령에서도 돈다), 예:
#   SPRING_APPLICATION_JSON="$PAYCORE_MASTER_ENTITLEMENT_JSON" java -jar master-api.jar
# payment-api 쪽은 PAYCORE_PAYMENT_AUTHORIZATION_JSON에 "payment":{"entitlement":{"clock-skew-margin":"PT2S","inbox":{"signing-keys":[{"key-id":"${PAYCORE_ENTITLEMENT_CHANNEL_KEY_ID}","secret":"${PAYCORE_ENTITLEMENT_CHANNEL_KEY_BASE64}"}]}}}를 더한다.
# endpoint 포트 = payment-api paycore.payment.api.internal-port(공개 포트와 다름). 값 이름은 EntitlementSettings(master·payment)·EntitlementInboxSettings 기준.
PAYCORE_ENTITLEMENT_CHANNEL_KEY_ID=
PAYCORE_ENTITLEMENT_CHANNEL_KEY_BASE64=
# payment-api에 준 paycore.payment.api.internal-port 값(로컬에서 정한다 — 같은 값을 payment-api 설정에도 넣는다).
PAYCORE_PAYMENT_INTERNAL_PORT=
PAYCORE_MASTER_ENTITLEMENT_JSON='{"paycore":{"master":{"entitlement":{"lease-duration":"PT5M","renew-before":"PT2M","scheduling-enabled":true,"renew-scan-interval":"PT30S","relay":{"poll-interval":"PT1S","batch-size":50,"claim-lease":"PT30S","backoff-initial":"PT1S","backoff-max":"PT1M","backoff-jitter-ratio":0.2},"dispatch":{"endpoint":"http://127.0.0.1:${PAYCORE_PAYMENT_INTERNAL_PORT}/internal/v1/entitlement-snapshots","connect-timeout":"PT1S","read-timeout":"PT3S","signing-key-id":"${PAYCORE_ENTITLEMENT_CHANNEL_KEY_ID}","signing-key":"${PAYCORE_ENTITLEMENT_CHANNEL_KEY_BASE64}"}}}}}'
# DEMO-SEED-001: DEMO 전용 1회성 명령(부록 D 4·6항). 배치 모드는 명령에만 준다(웹 프로세스에는 두지 않는다 — LIVE 배포 구성에 DEMO 값·명령 변수가 없어야 한다, 명세 §11).
#   java -jar master-api.jar --paycore.master.command=demo-seed --paycore.master.deployment-mode=DEMO --output=file:$HOME/paycore-demo/demo-merchant.tsv --effective-from=<다음 KST 자정>
#   java -jar payment-api.jar --paycore.payment.command=demo-credential --paycore.payment.deployment-mode=DEMO --output=file:$HOME/paycore-demo/demo-api-key.tsv --merchant-account-id=<MID>

# payment-api 로컬 실행용 (비밀번호는 위 PAYCORE_PAYMENT_DB_PASSWORD / PAYCORE_PAYMENT_DB_MIGRATION_PASSWORD 공유)
# application.yml이 Flyway를 migration 계정(spring.flyway.user/password)으로, migration 세션을 UTC(init-sqls)로 고정한다.
# SPRING_FLYWAY_USER/PASSWORD 같은 프로세스 환경변수를 따로 넣지 않는다(다른 앱과 공유하면 그 앱의 Flyway 계정을 덮어쓴다).
PAYCORE_PAYMENT_DB_URL=jdbc:mysql://127.0.0.1:3306/paycore_payment
PAYCORE_PAYMENT_DB_USERNAME=paycore_payment
PAYCORE_PAYMENT_DB_MIGRATION_USERNAME=paycore_payment_migration

# ADMIN DB(internal-admin 소유 — ADMIN-BOOT-001 §4.2.1, D-ADMIN-005). runtime 계정(role의 표 단위 SELECT·INSERT + 열 단위 UPDATE만, DELETE 없음 — 세션 표만 전체 DML)과
# migration 계정(paycore_admin ALL, GRANT OPTION 없음, Flyway 전용). compose.yaml이 두 비밀번호를 요구한다(없으면 compose 기동 거부 — fail-closed).
# 기존 volume·.env(이 변경 전): (1) 아래 두 비밀번호를 .env에 추가 (2) 실행 중인 컨테이너에서 초기화 스크립트를 한 번 다시 실행(재실행 안전 — 기존 표·열 권한 유지):
#   docker compose up -d mysql && docker compose exec mysql bash /docker-entrypoint-initdb.d/01-owned-databases.sh
#   (환경변수를 바꾼 뒤에는 `docker compose up -d mysql`로 컨테이너를 다시 만들어야 새 변수가 컨테이너에 들어간다.)
#   확인: 스크립트가 exit 0이고 stderr에 "ADMIN passwords not set — skipping paycore_admin" 안내가 **없어야** 한다(있으면 변수가 컨테이너에 없다 —
#   ADMIN 계정이 이미 있는 volume에서는 이 경우 스크립트가 실패한다).
# 그다음 internal-admin을 기동하면 Flyway(migration 계정)가 표와 runtime 권한(db/runtime-privilege/admin)을 만든다. 스크립트를 실행하지 않으면 계정이 없어 기동하지 않는다.
PAYCORE_ADMIN_DB_PASSWORD=
PAYCORE_ADMIN_DB_MIGRATION_PASSWORD=
# internal-admin 로컬 실행용 (비밀번호는 위 두 값 공유)
PAYCORE_ADMIN_DB_URL=jdbc:mysql://127.0.0.1:3306/paycore_admin
PAYCORE_ADMIN_DB_USERNAME=paycore_admin
PAYCORE_ADMIN_DB_MIGRATION_USERNAME=paycore_admin_migration

# financial-batch 로컬 실행용 (비밀번호는 위 PAYCORE_FINANCIAL_DB_PASSWORD / PAYCORE_FINANCIAL_DB_MIGRATION_PASSWORD 공유)
# FIN-DBACCOUNT-001(D-FFR-002): runtime 계정 paycore_financial은 DB 단위 권한 없이 role paycore_financial_runtime의 표·열 단위 권한만 갖는다(append-only 사실 표는
# SELECT·INSERT만, DELETE 없음). Flyway는 migration 계정(paycore_financial ALL, GRANT OPTION 없음)을 쓰고 V3(db/runtime-privilege/financial)가 runtime 권한을 준다.
# 기존 volume(이 변경 전 — paycore_financial 단일 계정이 DB ALL)·.env 수렴 절차:
#   (0) financial-batch를 멈춘다(수렴 중에는 runtime 계정에 표 권한이 없어 Inbox 수신이 실패한다). 멈춘 동안 PAYMENT Relay는 연결 실패를 재시도 대상으로
#       남긴다(격리는 FINANCIAL의 400·409·422 응답만 — FIN-FACT-RELAY-001 §4). 재기동 뒤 재전송은 Inbox 멱등으로 수렴한다.
#   (1) 위 PAYCORE_FINANCIAL_DB_MIGRATION_PASSWORD를 .env에 추가한다.
#   (2) docker compose up -d mysql  (변수를 바꾼 뒤에는 컨테이너를 다시 만들어야 새 변수가 들어간다)
#   (3) docker compose exec mysql bash /docker-entrypoint-initdb.d/01-owned-databases.sh
#       재실행 안전: migration 계정·runtime role·잠긴 grantor·procedure를 만들고 paycore_financial의 DB 단위 ALL·GRANT OPTION을 REVOKE한다(표 데이터는 그대로).
#       확인: exit 0이고 stderr에 "PAYCORE_FINANCIAL_DB_MIGRATION_PASSWORD not set" 안내가 **없어야** 한다. 변수가 컨테이너에 없으면 FINANCIAL 표가 있는 volume에서는
#       스크립트가 실패한다(exit 1 — 아무것도 바꾸지 않는다).
#   (4) financial-batch를 기동한다. Flyway(migration 계정)가 V3로 runtime 표·열 권한을 준 뒤 앱 pool이 연결된다. (3)을 하지 않으면 migration 계정이 없어 기동하지 않는다.
#   또는 volume 재생성(로컬 데이터가 지워진다): docker compose down -v && docker compose up -d
#   운영 DB는 DBA가 같은 SQL(특히 REVOKE와 ALTER USER … ACCOUNT LOCK)을 설치한다. 결과 기대값: apps/financial-batch FinancialDatabaseAccountSpec의 SHOW GRANTS.
PAYCORE_FINANCIAL_DB_URL=jdbc:mysql://127.0.0.1:3306/paycore_financial
PAYCORE_FINANCIAL_DB_USERNAME=paycore_financial
PAYCORE_FINANCIAL_DB_MIGRATION_USERNAME=paycore_financial_migration
# FIN-FACT-RELAY-001(D-ACQ-001): PAYMENT → FINANCIAL 결제 사실 채널. financial-batch는 내부 HTTP Inbox를 연다(공개 API 없음 — Inbox 경로·health 밖은 404).
# 포트·바인딩 주소는 기본값이 없다(값이 없으면 기동 실패). 로컬 Demo는 loopback만. 운영은 내부망 주소 + mTLS(LIVE Gate).
PAYCORE_FINANCIAL_INBOX_PORT=
PAYCORE_FINANCIAL_INBOX_ADDRESS=127.0.0.1
# 결제 사실 채널 서명 키(이 채널 전용 키 공간 — 권리 채널·ADMIN 채널 키와 바이트·kid가 같으면 payment-api가 기동을 거부한다). key id([A-Za-z0-9._-]{1,32})와
# Base64 비밀(디코드 32바이트 이상, 예: `openssl rand -base64 32`). 저장소에 값을 두지 않는다. Demo 전용 — 운영 키는 비밀 저장소에서 주입한다.
PAYCORE_FINANCIAL_FACT_CHANNEL_KEY_ID=
PAYCORE_FINANCIAL_FACT_CHANNEL_KEY_BASE64=
# ACQ-VIEW-001(R-2 A): ADMIN → FINANCIAL 서명 채널(매입 현황 조회 — 읽기 전용). 이 채널 전용 키 공간 — 결제 사실 채널 키와 kid·바이트가 같으면 financial-batch가 기동을
# 거부한다(채널별 별도 키). 설정은 **필수**다(없으면 financial-batch 기동 실패 — I-8). 같은 key id·Base64 비밀을 internal-admin 호출 측(ACQ-VIEW-001 B2 —
# PAYCORE_ADMIN_FINANCIAL_OPS_*)에도 준다. 값은 저장소에 두지 않는다(예: `openssl rand -base64 32`). Demo 전용 — 운영 키는 비밀 저장소.
PAYCORE_FINANCIAL_ADMIN_CHANNEL_KEY_ID=
PAYCORE_FINANCIAL_ADMIN_CHANNEL_KEY_BASE64=
# financial-batch 프로세스에만 SPRING_APPLICATION_JSON으로 넘긴다(시각 창 PT300S·본문 상한 64 KiB는 Demo 값 — 운영값 LIVE Gate), 예:
#   SPRING_APPLICATION_JSON="$PAYCORE_FINANCIAL_INBOX_JSON" ./gradlew :apps:financial-batch:bootRun
# ACQUIRING-001: 같은 JSON의 "acquiring" 객체 = 매입 송신자 ID·버전 관리 마감 정책(D-ACQ-003 — Demo 값, 운영값 아님. 업무일 = Asia/Seoul 달력일, Q-CALENDAR 전 Demo 한정).
# ACQ-VIEW-001: 같은 JSON의 "admin-channel" 객체 = ADMIN 채널 키·시각 창(PT300S)·조회 permit(2 — Demo 값, 운영값 LIVE Gate).
# ACQ-ADMIN-001(D-ACQA-001 "조작 전용 키 따로"): 같은 객체의 "operation-keys" = 매입 조작(재매입 실행 등) 전용 키 — 조회 키·결제 사실 키와 kid·바이트가 모두 달라야 한다
# (같으면 기동 거부). 설정은 **필수**다(없으면 financial-batch 기동 실패). "operation-permits"(1 — Demo), "max-execution-window"(PT24H — 승인 → 실행 기한 최대 폭, Demo).
# 같은 key id·Base64 비밀을 internal-admin 호출 측(PAYCORE_ADMIN_FINANCIAL_OPS_OPERATION_*)에도 준다. 값은 저장소에 두지 않는다.
PAYCORE_FINANCIAL_ADMIN_OPERATION_KEY_ID=
PAYCORE_FINANCIAL_ADMIN_OPERATION_KEY_BASE64=
PAYCORE_FINANCIAL_INBOX_JSON='{"paycore":{"financial":{"admin-channel":{"clock-window":"PT300S","read-permits":2,"signing-keys":[{"key-id":"${PAYCORE_FINANCIAL_ADMIN_CHANNEL_KEY_ID}","secret":"${PAYCORE_FINANCIAL_ADMIN_CHANNEL_KEY_BASE64}"}],"operation-permits":1,"max-execution-window":"PT24H","operation-keys":[{"key-id":"${PAYCORE_FINANCIAL_ADMIN_OPERATION_KEY_ID}","secret":"${PAYCORE_FINANCIAL_ADMIN_OPERATION_KEY_BASE64}"}]},"payment-fact-inbox":{"clock-window":"PT300S","max-body-bytes":65536,"signing-keys":[{"key-id":"${PAYCORE_FINANCIAL_FACT_CHANNEL_KEY_ID}","secret":"${PAYCORE_FINANCIAL_FACT_CHANNEL_KEY_BASE64}"}]},"acquiring":{"sender-id":"PAYCORE","cutoff-policies":[{"version":"acq-cutoff-demo-1","effective-from":"2026-01-01","cutoff-time":"23:00"}]}}}}'
# ACQUIRING-001 배치2(2-D 전송·2-F 결과 수신·마감·스케줄): 같은 JSON의 "acquiring" 객체에 아래 키를 더한다(Demo 값 — 운영값 아님, LIVE Gate). 기본은 모두 꺼져 있다(fail-closed).
#   "transport":{"lease":"PT2M","clock-skew-allowance":"PT1S","acquirers":{"SIMACQA":{"host":"127.0.0.1","port":<Simulator SFTP 포트>,"username":"paycore",
#     "private-key-path":"<저장소 밖 FINANCIAL 클라이언트 개인키 경로>","host-key-fingerprints":["SHA256:<Simulator host key 지문>"],"inbox-dir":"/inbox",
#     "outbox-dir":"/outbox","connect-timeout":"PT5S","io-timeout":"PT10S"}}},
#   "results":{"deadline":"PT3M"},
#   "schedule":{"enabled":true,"fixed-delay":"PT10S","batch-size":20,"max-seals-per-cycle":3,"lanes":[{"acquirer-code":"SIMACQA","environment":"TEST","first-business-date":"<첫 업무일>"}]}
# 키·지문·경로 값은 이 파일에 두지 않는다(D-ACQ-006). E2E 관찰 스크립트: harness/e2e/acquiring_e2e.py(실행 절차 — ACQUIRING-001 명세 §16 "E2E 실행 방법").
# payment-api 쪽 Relay 설정(Demo 1s·50건·claim 30s·backoff 1s~1m·jitter 0.2 — 운영값 아님). payment-api의 SPRING_APPLICATION_JSON(PAYCORE_PAYMENT_AUTHORIZATION_JSON)의
# "paycore" 객체에 아래 "financial-relay" 객체를 더한다(LocalDemoAuthorizationConfigSpec이 검사하는 기존 JSON은 바꾸지 않았다 — 합치는 것은 로컬 실행 절차).
PAYCORE_FINANCIAL_RELAY_JSON='{"paycore":{"financial-relay":{"dispatch":{"endpoint":"http://127.0.0.1:${PAYCORE_FINANCIAL_INBOX_PORT}/internal/v1/payment-facts","connect-timeout":"PT1S","request-timeout":"PT5S","signing-key-id":"${PAYCORE_FINANCIAL_FACT_CHANNEL_KEY_ID}","signing-key":"${PAYCORE_FINANCIAL_FACT_CHANNEL_KEY_BASE64}","max-ack-bytes":4096},"job":{"enabled":true,"fixed-delay":"PT1S","batch-size":50,"claim-lease":"PT30S","backoff-initial":"PT1S","backoff-max":"PT1M","backoff-jitter-ratio":0.2}}}}'

# institution-simulator(가상 인증기관, AUTHN-001) 로컬 실행용 — 별도 MySQL 인스턴스(compose simulator-mysql, 127.0.0.1:3307). Demo 전용, 운영 값 아님.
# 계정은 docker/simulator-mysql/init/01-simulator-database.sh가 빈 volume의 첫 기동에 만든다.
# compose profile "simulator"로만 기동한다: docker compose --profile simulator up -d simulator-mysql. 기존 .env에 아래 변수가 없어도 기본 compose 명령은
# 영향이 없다(변수를 추가한 뒤 profile로 기동한다 — 기존 .env 이전 절차).
PAYCORE_SIMULATOR_MYSQL_ROOT_PASSWORD=
PAYCORE_SIMULATOR_DB_PASSWORD=
PAYCORE_SIMULATOR_DB_MIGRATION_PASSWORD=
PAYCORE_SIMULATOR_DB_URL=jdbc:mysql://127.0.0.1:3307/paycore_simulator
PAYCORE_SIMULATOR_DB_USERNAME=paycore_simulator
PAYCORE_SIMULATOR_DB_MIGRATION_USERNAME=paycore_simulator_migration
PAYCORE_SIMULATOR_PORT=
# Simulator 대역 설정(Demo). client 키 원문은 PG(payment-api) 쪽 환경변수에만 두고 여기에는 그 SHA-256만 넣는다.
PAYCORE_SIMULATOR_CUSTOMER_BASE_URL=
PAYCORE_SIMULATOR_TRANSACTION_TTL=PT10M
PAYCORE_SIMULATOR_RESULT_VALIDITY=PT5M
PAYCORE_SIMULATOR_LOOKUP_DELAY=PT3S
PAYCORE_SIMULATOR_CLIENT_ID=pg-local
PAYCORE_SIMULATOR_CLIENT_KEY_SHA256=
PAYCORE_SIMULATOR_CLIENT_RETURN_ORIGIN=
# 가상 VAN(AUTH-001 §5·CANCEL-001 §6 — TCP, 계약 sim-van-2 = sim-van-1 + 취소·취소 조회). Demo 전용, 운영 값 아님. HTTP 포트와 다른 포트. HMAC 키는 32바이트 이상 임의 값의 base64(로컬에서 직접 만든 시험 키 —
# 같은 값을 payment-api 쪽 Route 등록부 환경변수에도 넣는다). 프로파일 A = 무효과 확정 Capability 있음, B = 없음. 신용 할부 개월은 결제창 Plan Demo 정책과 같은 값.
# 기존 Simulator 볼륨(AUTH-001 이전, runtime = DB 단위 DML)은 표 단위 권한으로 한 번 수렴시킨다 — 수렴 전에는 Simulator가 기동을 거부한다:
#   docker compose --profile simulator exec simulator-mysql bash /docker-entrypoint-initdb.d/01-simulator-database.sh
PAYCORE_SIMULATOR_VAN_PORT=
PAYCORE_SIMULATOR_VAN_KEY_ID=sim-van-local-1
PAYCORE_SIMULATOR_VAN_HMAC_KEY_BASE64=
PAYCORE_SIMULATOR_VAN_LATE_RESPONSE_DELAY=PT6S
PAYCORE_SIMULATOR_VAN_FRAGMENT_DELAY=PT0.01S
PAYCORE_SIMULATOR_VAN_IDLE_TIMEOUT=PT30S
PAYCORE_SIMULATOR_VAN_CLOSABLE_AFTER=PT2M
PAYCORE_SIMULATOR_VAN_INQUIRY_RETENTION=P7D
# 결제창 Plan Demo·payment-api Route Demo 할부 개월([2, 3, 6])과 같다(AUTH-001 §16.17 발견 2 — AU-31 기동 검사는 별도 프로세스인 Simulator 값을 보지 않는다).
PAYCORE_SIMULATOR_VAN_CREDIT_INSTALLMENT_MONTHS=2,3,6
PAYCORE_SIMULATOR_VAN_PENDING_DELAY=PT5S
# 가상 VAN 취소 Capability(CANCEL-001 §6.5 — sim-van-2, Demo 전용·운영 값 아님). 취소 무효과 종결 가능 시점·조회 보존기간·Demo 취소 기한(원 승인 기록 시각부터).
# 부분취소 지원 카드 종류는 프로파일별 Demo 고정값이다(Simulator application.yml — A: 신용·체크 일시불 + 신용 할부, B: 신용 일시불만).
PAYCORE_SIMULATOR_VAN_CANCEL_CLOSABLE_AFTER=PT2M
PAYCORE_SIMULATOR_VAN_CANCEL_INQUIRY_RETENTION=P7D
PAYCORE_SIMULATOR_VAN_CANCEL_WINDOW=P365D
PAYCORE_SIMULATOR_VAN_ACCOUNT_A=SIMMERCH0001
PAYCORE_SIMULATOR_VAN_ACCOUNT_B=SIMMERCH0002
# 가상 매입사(ACQUIRING-001 2-E — Simulator 내장 SFTP + ACK·결과 Worker). Demo 전용, 운영 값 아님. 기본은 꺼져 있다(매입사 0개 = SFTP 포트를 열지 않음 — fail-closed).
# 아래 이름은 모두 주석이다: 빈 값으로 넣으면 "매입사 설정 있음"이 되어 검증 실패로 기동이 거부되므로, 쓸 때만 주석을 풀고 값을 채운다(값·키는 이 파일에 두지 않는다).
# 키는 파일 경로로만 받는다(D-ACQ-006). 저장소 밖 디렉터리에서 로컬 생성(예: ~/.paycore-demo/acquirer, 운영 키 아님):
#   ssh-keygen -t ecdsa -b 256 -N "" -f <dir>/acquirer_host_ecdsa      # Simulator host 개인키(OpenSSH 형식, chmod 600 — 그룹·기타 권한이 있으면 기동 거부)
#   ssh-keygen -t ecdsa -b 256 -N "" -f <dir>/paycore_acq_client       # FINANCIAL 클라이언트 키쌍 — .pub을 Simulator 허용 공개키로, 개인키 경로를 financial-batch 설정에
#   ssh-keygen -lf <dir>/acquirer_host_ecdsa.pub -E sha256             # financial-batch host-key-fingerprints[0](SHA256:…)에 넣을 지문
# root-dir 아래 매입사마다 {code}/inbox(업로드)·{code}/outbox(ACK·결과)를 Simulator가 만든다. financial-batch 전송 설정은 inbox-dir=/inbox, outbox-dir=/outbox(chroot 안 경로).
# 업로드 임시명은 시도별 .{fileId}.dat.{n}.part(n = 1~999999 — Coordinator 결정 (9)), 끊긴 업로드의 임시 파일은 PARTRETENTION 뒤 Simulator가 지운다.
# 허용 공개키 파일·root-dir에 그룹·기타 쓰기 권한이 있으면 기동이 거부된다(chmod 644 공개키, chmod 700 root-dir).
# van-client는 위 PAYCORE_SIMULATOR_CLIENT_ID와 같은 값(가상 VAN 원장 namespace — SALE을 그 PG client의 VAN 승인과 대조).
# 결정적 시나리오(Demo 재현 — ACQUIRING-001 §7): ..._ACQUIRERS_0_SCENARIOS_<n>_ACTION = REJECT(+REASON) | WITHHOLD_RESULT | DELAY_RESULT(+DELAY) | DUPLICATE_RESULT |
# CONFLICTING_RESULT (레코드: _TRANSACTIONID 또는 _APPROVEDAMOUNTMINOR 중 하나, 선택 _FILEID) | FILE_REJECT | DROP_ACK | DELAY_ACK(+DELAY) (파일: _FILEID) |
# DISCONNECT_DURING_UPLOAD·DROP_RENAME_RESPONSE (SFTP 장애: _FILEID + _TIMES). 예: 승인액 13013원 레코드 거절 = ACTION=REJECT, APPROVEDAMOUNTMINOR=13013, REASON=DEMO_REJECTED.
# ACQ-ADMIN-001 B2 Demo(명세 §17.10 Demo 시나리오 — 이름만, 값은 Coordinator가 Demo 때 정한다): 원 파일 v001 파일 전체 거절 → 재매입 v002 수락/거절.
# 0번 = v001 FILE_REJECT(_FILEID = ACQ.<매입사>.TEST.<업무일>.001), 1번(선택 — v002 거절 장면) = REJECT + _FILEID(…002) + _TRANSACTIONID + _REASON. 1번이 없으면 v002는 VAN 원장 대조로 수락된다(C-8).
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_SCENARIOS_0_ACTION=
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_SCENARIOS_0_FILEID=
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_SCENARIOS_1_ACTION=
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_SCENARIOS_1_FILEID=
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_SCENARIOS_1_TRANSACTIONID=
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_SCENARIOS_1_REASON=
# PAYCORE_SIMULATOR_ACQUIRER_SFTP_BINDHOST=127.0.0.1
# PAYCORE_SIMULATOR_ACQUIRER_SFTP_PORT=
# PAYCORE_SIMULATOR_ACQUIRER_SFTP_HOSTKEYPATH=
# PAYCORE_SIMULATOR_ACQUIRER_ROOTDIR=
# PAYCORE_SIMULATOR_ACQUIRER_POLLINTERVAL=PT2S
# PAYCORE_SIMULATOR_ACQUIRER_ACKDELAY=PT0S
# PAYCORE_SIMULATOR_ACQUIRER_RESULTDELAY=PT30S
# PAYCORE_SIMULATOR_ACQUIRER_PARTRETENTION=PT1H
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_CODE=SIMACQA
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_USERNAME=paycore
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_AUTHORIZEDKEYPATHS_0=
# PAYCORE_SIMULATOR_ACQUIRER_ACQUIRERS_0_VANCLIENT=pg-local
# 2-E migration V10~V12는 아직 어느 Demo 볼륨에도 적용되지 않았다(Demo Simulator 볼륨은 V9). rev 0.9에서 V10 내용이 바뀌었으므로(V13 합침) 개발 중 V10 이상을
# 적용한 로컬 Simulator 볼륨이 있으면 Flyway checksum 검증으로 기동이 거부된다 — 그 볼륨만 지우고 다시 만든다(docker compose --profile simulator down -v는
# Simulator 외 볼륨도 지울 수 있으니 볼륨 이름을 확인하고 지운다). V9까지의 Demo 볼륨은 그대로 두고 아래 init 재실행만 하면 된다.
# Simulator DB에 열 권한 procedure(grant_runtime_column_update)가 2-E에서 추가됐다 — 기존 Simulator 볼륨은 init 스크립트를 한 번 다시 실행해야 V12 migration이 돈다:
#   docker compose --profile simulator exec simulator-mysql bash /docker-entrypoint-initdb.d/01-simulator-database.sh

# WEBHOOK-001: 같은 JSON의 paycore.webhook.*(fan-out 주기 Demo 5s·100건·실패 재시도 1m, test-endpoints 빈 목록 — 가맹점 수신기를 붙일 때만 TEST MID·https URL 추가. LIVE는 원천 없음 — fail-closed).
# payment-api 승인·취소 설정(AUTH-001 §20-3 — paycore.authorization.*, CANCEL-001 CN-29 — paycore.cancellation.timing.*: 취소 전송·회복 시간, Demo).
# CANCEL-001 S8(§20): Route SIMVAN01은 계약 sim-van-2(= sim-van-1 승인 메시지 바이트 동일 + 취소 4종)·취소 Capability(cancel 블록 — Simulator 프로파일 A 짝: 무효과 확정, 부분취소 신용·체크
# 일시불 + 신용 할부, closableAfter·보존기간은 위 PAYCORE_SIMULATOR_VAN_CANCEL_* 변수)이고, Route 모양이 바뀌었으므로 profile-version을 sim-van-a-demo-2로 올렸다(CN-28 — 이전 인스턴스와 혼재 금지,
# 배포 시점 진행 중 승인 UNKNOWN은 무효과 종결 대신 조회·이관 — CANCEL-001 §20).
# Demo 전용, 운영 값 아님. 운영 기본값이 없으므로 값이 없으면 payment-api 기동이 실패한다.
# Route 이름(SIMVAN01)·backend 환경 키(TEST)는 대문자라 일반 환경변수 이름(relaxed binding — Map 키 소문자화)으로 줄 수 없어 JSON 하나로 둔다.
# payment-api 프로세스에만 SPRING_APPLICATION_JSON으로 넘긴다(다른 앱 프로세스와 공유하지 않는다 — 위 SPRING_FLYWAY_* 주의와 같은 이유), 예:
#   SPRING_APPLICATION_JSON="$PAYCORE_PAYMENT_AUTHORIZATION_JSON" ./gradlew :apps:payment-api:bootRun
# host·port·key-id·HMAC 키·closable-after·inquiry-retention은 위 Simulator 변수를 ${…}로 참조해 짝을 맞춘다(§20-6 — 키 원문을 두 번 적지 않는다).
# 값은 payment-api 시험 설정(apps/payment-api/src/test/resources/config/application.yml)의 Demo 값과 같다. 다만 recovery.enabled는 로컬 Demo에서 회복 Worker가
# 돌도록 true(시험은 false로 두고 Use Case를 직접 부른다). Route는 프로파일 A(무효과 확정 있음) 하나 — Simulator 계정 A(SIMMERCH0001)와 짝.
# 검증: apps/payment-api LocalDemoAuthorizationConfigSpec(바인딩·Route 등록부·AU-34·m-2 기동 검사·Simulator 짝).
# 이 값만으로 payment-api 로컬 기동이 완성되지는 않는다 — 공개 API·결제창·인증 backend 설정(CP-API-001·AUTHN-001)도 필요하며 아직 이 파일에 예시가 없다.
PAYCORE_PAYMENT_AUTHORIZATION_JSON='{"paycore":{"webhook":{"test-endpoints":[],"test-signing-keys":[],"fanout":{"enabled":true,"fixed-delay":"PT5S","batch-size":100,"failed-retry-interval":"PT1M"},"transport":{"connect-timeout":"PT3S","response-timeout":"PT10S","request-deadline":"PT15S","dns-timeout":"PT2S","max-response-bytes":4096,"test-allowlist":[]},"delivery":{"claim-lease":"PT60S","schedule":{"version":"webhook-retry-demo-1","initial":"PT10S","max":"PT1H","jitter-ratio":0.2,"max-attempts":10,"max-age":"PT24H"},"job":{"enabled":true,"fixed-delay":"PT2S","batch-size":50}}},"cancellation":{"timing":{"dispatch":{"lease":"PT30S","safety-margin":"PT5S","prepared-deadline":"PT1S","gate-retry-interval":"PT0.2S"},"recovery":{"enabled":true,"fixed-delay":"PT5S","batch-size":50,"inquiry-interval":"PT10S","inquiry-budget":3,"max-age":"PT1H","slow-inquiry-interval":"PT10M","version":"cancel-recovery-demo-1"}}},"authorization":{"timing":{"dispatch":{"lease":"PT30S","safety-margin":"PT5S","prepared-deadline":"PT1S","gate-retry-interval":"PT0.2S"},"recovery":{"enabled":true,"fixed-delay":"PT5S","batch-size":50,"inquiry-interval":"PT10S","inquiry-budget":3,"max-age":"PT1H","slow-inquiry-interval":"PT10M","version":"recovery-demo-1"}},"backends":{"TEST":{"type":"SIMULATOR"}},"routes":{"SIMVAN01":{"environment":"TEST","institution":"SIMVAN","protocol-version":"sim-van-2","profile-version":"sim-van-a-demo-2","host":"127.0.0.1","port":"${PAYCORE_SIMULATOR_VAN_PORT}","key-id":"${PAYCORE_SIMULATOR_VAN_KEY_ID}","key-base64":"${PAYCORE_SIMULATOR_VAN_HMAC_KEY_BASE64}","connect-timeout":"PT0.5S","read-timeout":"PT1S","total-deadline":"PT2S","connect-retry-budget":2,"capabilities":{"confirms-no-effect":true,"closable-after":"${PAYCORE_SIMULATOR_VAN_CLOSABLE_AFTER}","inquiry-retention":"${PAYCORE_SIMULATOR_VAN_INQUIRY_RETENTION}","same-id-resend-safe":true,"authentication-evidence-reusable-for-resend":true,"supported-currencies":["KRW"],"supported-card-types":["CREDIT","CHECK"],"installment-card-types":["CREDIT"],"installment-months":[2,3,6],"installment-minimum-amount":50000,"cancel":{"version":"cancel-a-demo-1","partial-lump-sum-card-types":["CREDIT","CHECK"],"partial-installment-card-types":["CREDIT"],"confirms-no-effect":true,"closable-after":"${PAYCORE_SIMULATOR_VAN_CANCEL_CLOSABLE_AFTER}","inquiry-retention":"${PAYCORE_SIMULATOR_VAN_CANCEL_INQUIRY_RETENTION}"}}}}}}}'
# ADMIN → PAYMENT 내부 호출 서명 키(ADMIN-PAYMENT-OPS-001 §4.2, D-OPS-001 — ADMIN 전용 키 공간). key id([A-Za-z0-9._-]{1,32})와 Base64 비밀(디코드 32바이트 이상,
# 예: `openssl rand -base64 32`). 저장소에 값을 두지 않는다. 위 권리 채널(entitlement inbox) 키와 바이트·kid가 같으면 payment-api가 기동을 거부한다.
# 기본값이 없다(값이 없으면 payment-api 기동 실패). payment-api에는 SPRING_APPLICATION_JSON 등으로 다음 모양을 넘긴다(시각 창 PT300S는 Demo 값 — 운영값 LIVE Gate):
#   {"paycore":{"payment":{"admin-channel":{"clock-window":"PT300S","signing-keys":[{"key-id":"${PAYCORE_PAYMENT_ADMIN_CHANNEL_KEY_ID}","secret":"${PAYCORE_PAYMENT_ADMIN_CHANNEL_KEY_BASE64}"}]},
#     "admin-ops":{"max-execution-window":"PT24H","decision-stable-delay":"PT2M","read-permits":4,"command-permits":2,"public-pool-reserve":4},
#     "api":{"internal-max-threads":16,"internal-accept-count":16}}}}
#   (admin-ops·internal 상한은 ADMIN-PAYMENT-OPS-001 S3 Demo 값 — 운영값 LIVE Gate. read-permits + command-permits ≤ DB 풀 − public-pool-reserve가 아니면 기동 거부)
# 교체 중에만 signing-keys에 두 번째 키를 더한다. internal-admin 쪽 같은 키(PAYCORE_ADMIN_PAYMENT_OPS_*)는 ADMIN-PAYMENT-OPS-001 S5에서 더한다.
PAYCORE_PAYMENT_ADMIN_CHANNEL_KEY_ID=
PAYCORE_PAYMENT_ADMIN_CHANNEL_KEY_BASE64=
# internal-admin 계정 보안 키(ADMIN-BOOT-001 §4.3.4·§4.6 — base64로 인코딩한 256비트 무작위 값, 예: `openssl rand -base64 32`). 저장소에 값을 두지 않는다.
# TOTP 시크릿 AES-256-GCM 키(버전 1)와 미인증 login_name 감사용 HMAC 키. 키 교체·LIVE Demo 키 거부는 S4 이후.
# ADMIN-PAYMENT-OPS-001 S5: internal-admin → PAYMENT 내부 connector 호출(서명 키 = PAYMENT admin-channel 키와 같은 kid·Base64 값, 활성 1개).
# base-url은 경로 없이(예 http://127.0.0.1:8081 — PAYMENT 내부 포트). Demo 키도 저장소에 두지 않는다(LIVE에서 Demo·시험 키면 기동 실패).
PAYCORE_ADMIN_PAYMENT_OPS_BASE_URL=
PAYCORE_ADMIN_PAYMENT_OPS_KEY_ID=
PAYCORE_ADMIN_PAYMENT_OPS_SIGNING_KEY=
# MERCHANT-OPS-001: internal-admin → MASTER 내부 조회 호출(가맹점 조회). **PAYMENT ops 키와 다른** key id·Base64 비밀(`openssl rand -base64 32`)을 로컬에서 만든다(같으면
# internal-admin 기동 거부). 같은 값을 master-api의 paycore.master.admin-channel.signing-keys[0]에 넣는다(권리 dispatch 키와도 달라야 한다 — 같으면 master-api 기동 거부).
# master-api 웹 프로세스는 이 설정이 없으면 기동하지 않는다(기본값 없음 — demo-seed 명령 프로세스는 비웹이라 필요 없다). PAYCORE_MASTER_ENTITLEMENT_JSON의 "master" 객체에 다음을 더한다:
#   "admin-channel":{"clock-window":"PT300S","read-permits":4,"signing-keys":[{"key-id":"${PAYCORE_ADMIN_MASTER_OPS_KEY_ID}","secret":"${PAYCORE_ADMIN_MASTER_OPS_SIGNING_KEY}"}]}
#   (창·permit은 Demo 값 — 운영값 LIVE Gate). base-url은 경로 없이 master-api 주소(예 http://127.0.0.1:<master-api 포트>).
PAYCORE_ADMIN_MASTER_OPS_BASE_URL=
PAYCORE_ADMIN_MASTER_OPS_KEY_ID=
PAYCORE_ADMIN_MASTER_OPS_SIGNING_KEY=
# ACQ-VIEW-001: internal-admin → FINANCIAL 내부 조회 호출(매입 현황). 위 PAYCORE_FINANCIAL_ADMIN_CHANNEL_KEY_ID·_KEY_BASE64와 **같은** key id·Base64 비밀을 넣는다
# (PAYMENT ops·MASTER ops 키와 kid·바이트가 같으면 internal-admin 기동 거부 — 채널별 별도 키). base-url은 경로 없이 financial-batch 내부 주소
# (예 http://127.0.0.1:${PAYCORE_FINANCIAL_INBOX_PORT}). internal-admin은 이 설정이 없으면 기동하지 않는다(기본값 없음). 값은 저장소에 두지 않는다.
PAYCORE_ADMIN_FINANCIAL_OPS_BASE_URL=
PAYCORE_ADMIN_FINANCIAL_OPS_KEY_ID=
PAYCORE_ADMIN_FINANCIAL_OPS_SIGNING_KEY=
# ACQ-ADMIN-001 B1-A: internal-admin → FINANCIAL 매입 조작(재매입) 서명 키. 위 PAYCORE_FINANCIAL_ADMIN_OPERATION_KEY_ID·_KEY_BASE64와 **같은** 값을 넣는다(조회 키와 다른 kid·비밀 —
# 같으면 양쪽 모두 기동 거부, D-ACQA-001). 값은 저장소에 두지 않는다. Demo 전용 — 운영 키는 비밀 저장소.
PAYCORE_ADMIN_FINANCIAL_OPS_OPERATION_KEY_ID=
PAYCORE_ADMIN_FINANCIAL_OPS_OPERATION_SIGNING_KEY=
PAYCORE_ADMIN_TOTP_CIPHER_KEY_V1=
PAYCORE_ADMIN_LOGIN_NAME_HMAC_KEY=
# internal-admin 배치 모드(DEMO|LIVE — 기본값 없음, ADMIN-BOOT-001 §4.8.2)와 IP 허용 목록(쉼표 구분 IP·CIDR, 필수 — §4.8.1). 로컬 개발은 DEMO·127.0.0.1.
PAYCORE_ADMIN_DEPLOYMENT_MODE=DEMO
PAYCORE_ADMIN_IP_ALLOWLIST=127.0.0.1,::1
# internal-admin management 포트(D-15 — actuator health만, 기본 바인딩 127.0.0.1, 웹 포트와 다른 값). 변수를 아예 두지 않으면 -1(HTTP actuator 없음).
# 빈 값으로 두지 않는다(빈 값이면 Boot가 웹 포트와 같은 포트로 본다 — 웹 체인이 /actuator/**를 거부하지만 D-15 분리가 깨진다).
PAYCORE_ADMIN_MANAGEMENT_PORT=8091
